# free-tier Gemini key from https://aistudio.google.com
GEMINI_API_KEY=your-key-here

# Model choice is configuration, not design. Use whatever your key offers.
AGENT_MODEL=gemini-3.5-flash-lite
SIM_MODEL=gemini-3.1-flash-lite
DIAGNOSER_MODEL=gemini-3.8-flash
# tried in order if the diagnoser model is overloaded (free-tier 503s)
DIAGNOSER_FALLBACKS=gemini-flash-latest,gemini-3.5-flash-lite
# JUDGE_MODEL=

# client-side rate limit (requests per minute) so free-tier 429s stay rare
LLM_RPM=10

# optional chaos: probability a read tool returns a transient error (agent should retry)
CHAOS=0
